# App
# Public URL for OAuth redirects. Leave unset on Vercel to use VERCEL_URL per deployment.
APP_URL=http://localhost:3000
# Same value on every Vercel env that shares the same database (Preview + Production).
APP_SECRET=change-me-to-a-long-random-string

# Database — use ONE of these:
# Local Docker / generic Postgres:
DATABASE_URL=postgresql://konnect:konnect@localhost:5432/konnect
# Vercel Postgres (auto-injected when you create Storage → Postgres and link the project):
# POSTGRES_URL=postgresql://...

# AI briefing (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OAuth — see README "OAuth apps" for where to create each app.
# Redirect URL pattern: {public-origin}/api/oauth/<provider>/callback
# <provider>: slack | linear | google | todoist | notion

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=

NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
